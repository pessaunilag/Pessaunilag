# ---- Required ----
# Supabase > Project Settings > Database > Connection string (use the "Transaction" pooler, port 6543)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Any long random text (keep it secret). Signs login sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-string
# Public address of the site
SITE_URL=https://pessaunilag.vercel.app

# ---- Photos (Supabase Storage, S3 protocol) ----
# Supabase > Project Settings > Storage > S3 connection
S3_ENDPOINT=https://xxxx.storage.supabase.co/storage/v1/s3
S3_REGION=eu-west-1
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL of the bucket: https://xxxx.supabase.co/storage/v1/object/public/media
S3_PUBLIC_URL=

# ---- Email (Resend) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=PESSA UNILAG website
NOTIFY_EMAIL=pessaunilag@gmail.com

# ---- Daily fetch of departmental news (Vercel Cron) ----
CRON_SECRET=another-long-random-string
